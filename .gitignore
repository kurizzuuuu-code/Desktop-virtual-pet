# Dependencies (reinstall with `npm install`)
node_modules/
discord-ai-agent/node_modules/

# Build outputs (rebuilt with `npm run build`)
build-output*/
release/
dist/
*.exe

# Distribution archives
*.zip

# Secrets — NEVER commit these (see discord-ai-agent/.env.example for the template)
.env
discord-ai-agent/.env

# Baked per-machine defaults (regenerated by `prebuild` from the dev config)
assets/baked-defaults.json
assets/baked-avatars/

# Logs and OS junk
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Side experiments — not part of the app (kept locally, untracked)
discord-ai-agent/
gemini ver/
toy/
